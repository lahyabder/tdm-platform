# --- Supabase Public Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_for_client_reads

# --- Supabase Server-Side Configuration (CRITICAL FOR SECURE WRITES) ---
# This service role key must remain SECRET. It bypasses RLS on the server side safely.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Cryptographic Security Settings ---
# A strong, unique 32-character secret key used to sign administration session cookies.
# DO NOT share this or keep fallback values in production.
ADMIN_JWT_SECRET=your_32_character_strong_hexadecimal_secret_key

# --- Primary Admin User Configuration (Fallback if admin_users database table is empty) ---
ADMIN_USER=admin_manager
ADMIN_PASS=tdm2026secure_or_custom_strong_password
